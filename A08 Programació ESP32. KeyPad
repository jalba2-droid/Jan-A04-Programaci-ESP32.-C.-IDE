#include <Keypad.h>

const uint8_t ROWS = 4;
const uint8_t COLS = 4;

char keys[ROWS][COLS] = {
  {'1', '2', '3', 'A'},
  {'4', '5', '6', 'B'},
  {'7', '8', '9', 'C'},
  {'*', '0', '#', 'D'}
};

// Pines actualizados a los laterales del ESP32
uint8_t colPins[COLS] = { 13, 12, 14, 27 }; // C1, C2, C3, C4
uint8_t rowPins[ROWS] = { 26, 25, 33, 32 }; // R1, R2, R3, R4

Keypad keypad = Keypad(makeKeymap(keys), rowPins, colPins, ROWS, COLS);

// Variables para el Password
String passwordCorrecte = "1234"; // Contraseña secreta
String inputPassword = "";        // Lo que va tecleando el usuario

void setup() {
  Serial.begin(9600);
  Serial.println("Introdueix el password i prem # per validar.");
}

void loop() {
  char key = keypad.getKey();

  if (key) {
    // Si pulsa #, comprobamos el password
    if (key == '#') {
      Serial.println();
      Serial.print("Validant: ");
      Serial.println(inputPassword);
      
      if (inputPassword == passwordCorrecte) {
        Serial.println("Password CORRECTE! Porta oberta.");
      } else {
        Serial.println("Password INCORRECTE. Torna-ho a provar.");
      }
      // Reiniciem la variable para el siguiente intento
      inputPassword = ""; 
    } 
    // Si pulsa *, borramos todo lo escrito
    else if (key == '*') {
      Serial.println("\n[Esborrat]");
      inputPassword = "";
    } 
    // Si pulsa un número o letra, lo añadimos al password
    else {
      inputPassword += key;
      Serial.print(key); // Lo mostramos por pantalla para que el usuario lo vea
    }
  }
}
